# LLM Provider Configuration: "lmstudio", "openrouter", or "auto"
LLM_PROVIDER=auto

# Local LM Studio (e.g., Apple Silicon M-series local server)
LM_STUDIO_BASE_URL=http://localhost:1234/v1
LM_STUDIO_MODEL=google/gemma-4-e4b

# OpenRouter Configuration
OPENROUTER_API_KEY=your_openrouter_api_key_here
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_MODELS=nex-agi/nex-n2.5-pro:free,nex-agi/nex-n2.5-mini:free,nvidia/nemotron-3-super-120b-a12b:free,openrouter/free
OPENROUTER_JUDGE_MODEL=nvidia/nemotron-3-super-120b-a12b:free

# Prompt Caching
CACHE_ENABLED=true
CACHE_DB_PATH=data/cache.sqlite
